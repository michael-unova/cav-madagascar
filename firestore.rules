rules_version = '2';

// Firestore Security Rules for the E-Learning Platform.
//
// Milestone 2 introduces the `users` collection: one document per account,
// keyed by the Firebase Authentication uid, storing the user's role.
//
// Milestone 3 adds `classes`, `courses`, and `enrollments`.
//
// Milestone 4 adds `lessons` and, nested under each lesson, its
// `materials` subcollection. Lesson videos and material files themselves
// live in Cloud Storage; see `storage.rules`.
//
// Rules for collections introduced by later milestones (assignments,
// submissions, comments, announcements) should be added alongside those
// milestones. Until then, the catch-all rule at the end denies all access
// to keep the default posture closed rather than open.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      // A user may only read their own profile document. There is no
      // general "list all users" read access yet; that belongs to a
      // future admin-facing milestone with its own authorization design.
      allow read: if isSignedIn() && request.auth.uid == userId;

      // A user may create their own profile document exactly once, at
      // sign-up, and only as 'student' or 'teacher'. 'admin' accounts are
      // never self-assignable from the client; they are provisioned
      // manually (Firebase console or a trusted backend).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'createdAt']);

      // Profile editing and role changes are not implemented in Milestone
      // 2. Disallowing update/delete for now also prevents a user from
      // escalating their own role by writing over their document.
      allow update: if false;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Milestone 3: classes, courses, enrollments.
    //
    // A class document's id is also the code students type to join it, so
    // knowing that id is what authorizes a student to enroll. Membership
    // itself lives in `enrollments`, keyed `{classId}_{studentId}`, which
    // turns every access check below into a single `exists()` lookup.
    // ---------------------------------------------------------------

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return isSignedIn() && userRole() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && userRole() == 'student';
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function classExists(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId));
    }

    function isClassTeacher(classId) {
      return isSignedIn()
        && classExists(classId)
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function isEnrolled(classId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/enrollments/$(classId + '_' + request.auth.uid));
    }

    function isCourseTeacher(courseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }

    match /classes/{classId} {
      // Reading a single class: its teacher, an enrolled student, or an
      // administrator. A student who is not enrolled cannot read a class
      // even when they know its id, so the code alone never leaks class
      // content: it only allows the enrollment write below.
      allow get: if isSignedIn()
        && (resource.data.teacherId == request.auth.uid || isEnrolled(classId) || isAdmin());

      // Listing is deliberately narrower than `get`: a teacher may only
      // query their own classes, and nobody else may enumerate the
      // collection. Students reach their classes through `enrollments`.
      allow list: if isSignedIn()
        && (resource.data.teacherId == request.auth.uid || isAdmin());

      allow create: if isTeacher()
        && request.resource.data.id == classId
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && request.resource.data.teacherName is string
        && request.resource.data.keys().hasOnly(
          ['id', 'name', 'description', 'teacherId', 'teacherName', 'createdAt', 'updatedAt']);

      // Only the owning teacher may edit, and only the editable fields:
      // reassigning a class to another teacher, or rewriting its id or
      // creation date, is never a legitimate client operation.
      allow update: if isSignedIn()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && request.resource.data.keys().hasOnly(
          ['id', 'name', 'description', 'teacherId', 'teacherName', 'createdAt', 'updatedAt']);

      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /courses/{courseId} {
      // `teacherId` is duplicated on the course so a teacher's own query
      // resolves without a lookup; students are checked against their
      // enrollment in the owning class.
      //
      // Read uses `isClassTeacher(resource.data.classId)` rather than
      // `resource.data.teacherId == request.auth.uid` directly, even
      // though the two are always equal in practice (enforced by the
      // `create`/`update` rules below). This is not a stylistic choice:
      // `listCoursesByClass` queries with `where('classId', '==', classId)`,
      // and Cloud Firestore validates a list query's shape against the rule
      // BEFORE looking at any data, using only the query's own filters. A
      // `classId` filter lets Firestore resolve `isClassTeacher(resource
      // .data.classId)` to a single provable boolean; it cannot do the same
      // for `resource.data.teacherId`, since nothing in the query
      // constrains that field, and denies the entire query as
      // unprovable, regardless of whether any document would actually have
      // violated it. This bit a real teacher viewing a real class with
      // zero courses in it: the list was denied outright, not returned
      // empty, because the rule as originally written could never be
      // proven safe for that query shape at all, empty or not.
      allow read: if isSignedIn()
        && (isClassTeacher(resource.data.classId)
          || isEnrolled(resource.data.classId)
          || isAdmin());

      allow create: if isTeacher()
        && request.resource.data.id == courseId
        && request.resource.data.teacherId == request.auth.uid
        && isClassTeacher(request.resource.data.classId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 800
        && request.resource.data.keys().hasOnly(
          ['id', 'classId', 'teacherId', 'title', 'description', 'createdAt', 'updatedAt']);

      // A course cannot be moved to another class or handed to another
      // teacher from the client: both would sidestep the ownership checks
      // that every other rule here depends on.
      allow update: if isSignedIn()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 800
        && request.resource.data.keys().hasOnly(
          ['id', 'classId', 'teacherId', 'title', 'description', 'createdAt', 'updatedAt']);

      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /enrollments/{enrollmentId} {
      // A student sees their own enrollments; a teacher sees the roster of
      // their own classes. Both shapes are queryable because every
      // returned document satisfies one of these conditions.
      allow read: if isSignedIn()
        && (resource.data.studentId == request.auth.uid
          || isClassTeacher(resource.data.classId)
          || isAdmin());

      // Students enroll themselves. The deterministic id is enforced here,
      // so a student cannot create an enrollment for somebody else, and
      // the class must exist, so a mistyped code fails rather than
      // creating a dangling membership. `studentEmail` is checked against
      // the authentication token; `studentName` is the student's own name
      // and is copied so teachers can display a roster without read
      // access to the `users` collection.
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && enrollmentId == request.resource.data.classId + '_' + request.auth.uid
        && request.resource.data.id == enrollmentId
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && classExists(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(
          ['id', 'classId', 'studentId', 'studentName', 'studentEmail', 'createdAt']);

      // An enrollment is a fact, not a record to edit: leaving a class
      // deletes it and rejoining creates it again.
      allow update: if false;

      // A student may leave a class; a teacher may remove a student from
      // a class they own.
      allow delete: if isSignedIn()
        && (resource.data.studentId == request.auth.uid || isClassTeacher(resource.data.classId));
    }

    // ---------------------------------------------------------------
    // Milestone 4: lessons, and each lesson's materials subcollection.
    //
    // A lesson's video is not stored here: Firestore only holds a pointer
    // to it (`videoPath`, a Cloud Storage path). The bytes themselves, for
    // both the video and every material, live in Cloud Storage, whose
    // rules are in `storage.rules`. Those rules re-derive the same
    // teacher/enrollment checks used below by reading these very documents
    // through the `firestore.get()`/`firestore.exists()` functions Storage
    // Security Rules can call, so one ownership model governs both
    // services instead of two independently-maintained ones.
    // ---------------------------------------------------------------

    function courseClassId(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.classId;
    }

    match /lessons/{lessonId} {
      // Same shape as `courses`: the owning teacher, an enrolled student
      // (via the denormalized `classId`), or an administrator.
      //
      // Teacher access uses `isCourseTeacher(resource.data.courseId)`
      // rather than `resource.data.teacherId == request.auth.uid`, for the
      // same list-query-provability reason documented on `courses` above:
      // `listLessonsByCourse` queries with `where('courseId', '==',
      // courseId)`, so the rule must be provable from a bound `courseId`,
      // not from an unconstrained `teacherId` field, or Cloud Firestore
      // denies the whole query regardless of what data actually exists.
      allow read: if isSignedIn()
        && (isCourseTeacher(resource.data.courseId)
          || isEnrolled(resource.data.classId)
          || isAdmin());

      // `classId` must actually be the class of `courseId`: without this
      // check, a teacher could create a lesson under their own course but
      // stamp it with a different class's id, which would let students of
      // that other class read a lesson that has nothing to do with their
      // own course list. A new lesson never has a video yet: it is
      // uploaded afterward through `allow update` below, once the lesson
      // (and therefore the Storage path that names it) exists.
      allow create: if isTeacher()
        && request.resource.data.id == lessonId
        && request.resource.data.teacherId == request.auth.uid
        && isClassTeacher(request.resource.data.classId)
        && courseClassId(request.resource.data.courseId) == request.resource.data.classId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 800
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.videoPath == null
        && request.resource.data.videoName == null
        && request.resource.data.videoSizeBytes == null
        && request.resource.data.keys().hasOnly([
          'id', 'courseId', 'classId', 'teacherId', 'title', 'description',
          'order', 'videoPath', 'videoName', 'videoSizeBytes', 'createdAt', 'updatedAt']);

      // A lesson cannot change which course or class it belongs to, or
      // change hands to another teacher, for the same reason as `courses`
      // above. `order` is editable (the "move up" / "move down" controls
      // in `swapLessonOrder`), and the three video fields are editable
      // only as a group: `updateLessonVideo` always sets all three
      // together after a Storage upload succeeds, or clears all three
      // together when a video is removed, so a lesson is never left
      // pointing at a video name without a path or vice versa.
      allow update: if isSignedIn()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 800
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && (request.resource.data.videoPath is string || request.resource.data.videoPath == null)
        && (request.resource.data.videoName is string || request.resource.data.videoName == null)
        && (request.resource.data.videoSizeBytes is number || request.resource.data.videoSizeBytes == null)
        && request.resource.data.keys().hasOnly([
          'id', 'courseId', 'classId', 'teacherId', 'title', 'description',
          'order', 'videoPath', 'videoName', 'videoSizeBytes', 'createdAt', 'updatedAt']);

      // Deleting a lesson document does not delete its video or materials
      // from Storage; the client (`deleteLessonWithContent`) always removes
      // those first, while this document still exists to authorize that
      // removal in `storage.rules`. See the note there for why the order
      // matters.
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;

      match /materials/{materialId} {
        function lessonTeacherId() {
          return get(/databases/$(database)/documents/lessons/$(lessonId)).data.teacherId;
        }

        function lessonClassId() {
          return get(/databases/$(database)/documents/lessons/$(lessonId)).data.classId;
        }

        allow read: if isSignedIn()
          && (lessonTeacherId() == request.auth.uid || isEnrolled(lessonClassId()) || isAdmin());

        // A material document is written only after its file has already
        // been uploaded to Storage (see `addLessonMaterial` in
        // `lessonStorage.ts`), so this write is really a receipt for an
        // upload `storage.rules` already had to authorize separately. The
        // checks below stand on their own regardless: `classId` is
        // cross-checked against the parent lesson so a material can never
        // be filed under a class other than its lesson's.
        allow create: if isSignedIn()
          && lessonTeacherId() == request.auth.uid
          && request.resource.data.id == materialId
          && request.resource.data.lessonId == lessonId
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.classId == lessonClassId()
          && request.resource.data.courseId is string
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.size() > 0
          && request.resource.data.sizeBytes is number
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 25 * 1024 * 1024
          && request.resource.data.contentType is string
          && request.resource.data.keys().hasOnly([
            'id', 'lessonId', 'courseId', 'classId', 'teacherId', 'name',
            'storagePath', 'sizeBytes', 'contentType', 'createdAt']);

        // Materials are immutable: replacing one means deleting it and
        // adding a new one (see `LessonMaterialsPanel`). This keeps a
        // material's Storage path, which is derived from its original file
        // name, from ever disagreeing with a renamed `name` field.
        allow update: if false;

        allow delete: if isSignedIn() && lessonTeacherId() == request.auth.uid;
      }
    }

    // Deny by default for every collection not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
