rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function activeUser() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function manager() {
      return activeUser() && (role() == 'content_manager' || role() == 'super_admin');
    }
    function admin() { return activeUser() && role() == 'super_admin'; }
    function activeOwner(uid) { return activeUser() && owner(uid); }

    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active';
      allow read: if owner(uid) || manager();
      allow update: if activeUser()
        && owner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == resource.data.email
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow update: if admin();
      allow delete: if admin();
    }

    match /courses/{id} {
      allow read: if resource.data.status == 'published' || manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /courseGroups/{id} {
      allow read: if resource.data.status == 'published' || manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /subjects/{id} {
      allow read: if resource.data.status == 'published' || manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /courseSubjects/{id} {
      allow read: if resource.data.status == 'published' || manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /contentNodes/{id} {
      allow read: if resource.data.status == 'published' || manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /contentBlocks/{id} {
      allow read: if manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /contactMessages/{id} {
      allow create: if request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 100
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'unread'
        && request.resource.data.createdAt == request.time
        && request.resource.data.readAt == null;
      allow read: if manager();
      allow update: if manager();
      allow delete: if manager();
    }

    match /payments/{id} {
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.currency == 'MGA'
        && request.resource.data.method in ['mvola', 'orange_money', 'airtel_money']
        && request.resource.data.reference is string
        && request.resource.data.reference.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.courseId is string
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'published'
        && request.resource.data.amount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price;
      allow read: if activeOwner(resource.data.userId) || manager();
      allow update: if manager();
      allow delete: if manager();
    }

    match /enrollments/{id} {
      allow read: if activeOwner(resource.data.userId) || manager();
      allow create, update, delete: if manager();
    }

    match /enrollmentHistory/{id} {
      allow read: if activeOwner(resource.data.userId) || manager();
      allow create, update, delete: if manager();
    }

    match /progress/{id} {
      allow read: if activeOwner(resource.data.userId) || manager();
      allow create: if activeOwner(request.resource.data.userId);
      allow update: if activeOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.nodeId == resource.data.nodeId;
      allow delete: if activeOwner(resource.data.userId) || manager();
    }

    match /bookmarks/{id} {
      allow read: if activeOwner(resource.data.userId);
      allow create: if activeOwner(request.resource.data.userId);
      allow update: if activeOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if activeOwner(resource.data.userId);
    }

    match /notes/{id} {
      allow read: if activeOwner(resource.data.userId);
      allow create: if activeOwner(request.resource.data.userId);
      allow update: if activeOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if activeOwner(resource.data.userId);
    }

    function activeEnrollment(courseId) {
      return signedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId))
        && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active'
        && (!('expiresAt' in get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data)
          || get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.expiresAt > request.time);
    }

    match /lessonComments/{id} {
      allow read: if manager() || (activeUser() && activeEnrollment(resource.data.courseId));
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorRole is string
        && ((request.resource.data.authorRole == 'student' && role() == 'student') || (request.resource.data.authorRole == 'manager' && manager()))
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 160
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() > 0
        && request.resource.data.courseTitle is string
        && request.resource.data.courseTitle.size() > 0
        && request.resource.data.subjectId is string
        && request.resource.data.subjectId.size() > 0
        && request.resource.data.subjectTitle is string
        && request.resource.data.subjectTitle.size() > 0
        && request.resource.data.lessonId is string
        && request.resource.data.lessonId.size() > 0
        && request.resource.data.lessonTitle is string
        && request.resource.data.lessonTitle.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 3000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.unreadForAdmin == (request.resource.data.authorRole == 'student')
        && request.resource.data.adminReply == null
        && request.resource.data.adminReplyBy == null
        && request.resource.data.adminReplyAt == null
        && (request.resource.data.parentCommentId == null
          || (request.resource.data.parentCommentId is string
            && exists(/databases/$(database)/documents/lessonComments/$(request.resource.data.parentCommentId))
            && get(/databases/$(database)/documents/lessonComments/$(request.resource.data.parentCommentId)).data.courseId == request.resource.data.courseId
            && get(/databases/$(database)/documents/lessonComments/$(request.resource.data.parentCommentId)).data.lessonId == request.resource.data.lessonId))
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'published'
        && exists(/databases/$(database)/documents/contentNodes/$(request.resource.data.lessonId))
        && get(/databases/$(database)/documents/contentNodes/$(request.resource.data.lessonId)).data.status == 'published'
        && (request.resource.data.authorRole == 'manager' || activeEnrollment(request.resource.data.courseId));
      allow update: if activeUser()
        && resource.data.userId == request.auth.uid
        && resource.data.authorRole == 'student'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.authorRole == resource.data.authorRole
        && request.resource.data.parentCommentId == resource.data.parentCommentId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.lessonId == resource.data.lessonId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 3000
        && request.resource.data.unreadForAdmin == true
        && request.resource.data.adminReply == resource.data.adminReply
        && request.resource.data.adminReplyBy == resource.data.adminReplyBy
        && request.resource.data.adminReplyAt == resource.data.adminReplyAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt', 'unreadForAdmin'])
        || (manager()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.studentName == resource.data.studentName
          && request.resource.data.authorRole == resource.data.authorRole
          && request.resource.data.parentCommentId == resource.data.parentCommentId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.courseTitle == resource.data.courseTitle
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.subjectTitle == resource.data.subjectTitle
          && request.resource.data.topicId == resource.data.topicId
          && request.resource.data.topicTitle == resource.data.topicTitle
          && request.resource.data.lessonId == resource.data.lessonId
          && request.resource.data.lessonTitle == resource.data.lessonTitle
          && request.resource.data.content == resource.data.content
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.unreadForAdmin == false
          && request.resource.data.adminReply == resource.data.adminReply
          && request.resource.data.adminReplyBy == resource.data.adminReplyBy
          && request.resource.data.adminReplyAt == resource.data.adminReplyAt)
        // A manager may edit the text of their own reply (never a student's comment).
        || (manager()
          && resource.data.userId == request.auth.uid
          && resource.data.authorRole == 'manager'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.studentName == resource.data.studentName
          && request.resource.data.authorRole == resource.data.authorRole
          && request.resource.data.parentCommentId == resource.data.parentCommentId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.courseTitle == resource.data.courseTitle
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.subjectTitle == resource.data.subjectTitle
          && request.resource.data.topicId == resource.data.topicId
          && request.resource.data.topicTitle == resource.data.topicTitle
          && request.resource.data.lessonId == resource.data.lessonId
          && request.resource.data.lessonTitle == resource.data.lessonTitle
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 3000
          && request.resource.data.unreadForAdmin == false
          && request.resource.data.adminReply == resource.data.adminReply
          && request.resource.data.adminReplyBy == resource.data.adminReplyBy
          && request.resource.data.adminReplyAt == resource.data.adminReplyAt)
        // A manager may record that they opened a question (only their own entry in seenBy).
        || (manager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
          && request.resource.data.seenBy.diff(resource.data.get('seenBy', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.seenBy[request.auth.uid].name is string
          && request.resource.data.seenBy[request.auth.uid].name.size() <= 160
          && request.resource.data.seenBy[request.auth.uid].at == request.time)
        // A manager may mark a root question as treated, or reopen it.
        || (manager()
          && resource.data.get('parentCommentId', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['treated', 'treatedById', 'treatedByName', 'treatedAt'])
          && request.resource.data.treated is bool
          && (request.resource.data.treated == false
            ? (request.resource.data.treatedById == null && request.resource.data.treatedByName == null && request.resource.data.treatedAt == null)
            : (request.resource.data.treatedById == request.auth.uid
              && request.resource.data.treatedByName is string
              && request.resource.data.treatedByName.size() <= 160
              && request.resource.data.treatedAt == request.time)));
      // Authors delete their own comment; admins and content managers can moderate (delete) any comment.
      allow delete: if (activeUser() && resource.data.userId == request.auth.uid) || manager();

      match /loves/{uid} {
        allow read: if manager() || (activeUser() && activeEnrollment(get(/databases/$(database)/documents/lessonComments/$(id)).data.courseId));
        allow create: if activeUser()
          && request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && activeEnrollment(get(/databases/$(database)/documents/lessonComments/$(id)).data.courseId);
        allow delete: if activeUser()
          && request.auth.uid == uid
          && resource.data.userId == request.auth.uid;
        allow update: if false;
      }
    }

    match /libraryBooks/{id} {
      // A public book is visible to every active account. A restricted book is
      // visible only to students whose backend-maintained active course access
      // overlaps at least one concours selected by the administrator.
      allow read: if manager()
        || (signedIn() && resource.data.status == 'published' && (
          // Published public resources should remain readable by signed-in students
          // even if an older user profile is missing its status field.
          !('visibility' in resource.data)
          || resource.data.visibility == 'public'
          || (activeUser() && resource.data.visibility == 'enrolled'
            && resource.data.courseIds is list
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.libraryCourseIds is list
            && resource.data.courseIds.hasAny(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.libraryCourseIds)
          )
          || (activeUser() && resource.data.visibility == 'enrolled' && resource.data.courseId is string && activeEnrollment(resource.data.courseId))
        ));
      allow create: if manager()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 240
        && request.resource.data.type in ['pdf', 'link']
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.visibility in ['public', 'enrolled']
        && (request.resource.data.visibility == 'public' || (request.resource.data.courseIds is list && request.resource.data.courseIds.size() > 0));
      allow update: if manager()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 240
        && request.resource.data.type in ['pdf', 'link']
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.visibility in ['public', 'enrolled']
        && (request.resource.data.visibility == 'public' || (request.resource.data.courseIds is list && request.resource.data.courseIds.size() > 0));
      allow delete: if manager();
    }

    match /psychotechnicalQuestions/{id} {
      allow read: if manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /psychotechnicalTests/{id} {
      allow read: if manager() || (activeUser() && resource.data.status == 'published');
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /lessonAttempts/{id} {
      allow read: if manager();
    }

    match /psychotechnicalAttempts/{id} {
      allow read: if activeOwner(resource.data.userId) || manager();
      allow create: if false;
      allow update, delete: if manager() || activeOwner(resource.data.userId);
    }

    match /questions/{id} {
      allow read: if manager() || (activeUser() && resource.data.status == 'published');
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /questionSets/{id} {
      allow read: if manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /practiceAttempts/{id} {
      allow read: if activeOwner(resource.data.userId) || manager();
      allow create: if false;
      allow update: if manager();
      allow delete: if activeOwner(resource.data.userId) || manager();
    }

    match /activityLogs/{id} {
      allow read: if manager();
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if admin();
    }

    match /notifications/{id} {
      allow read: if activeOwner(resource.data.userId);
      allow create: if manager();
      allow update: if activeOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId && request.resource.data.read is bool && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if admin();
    }

    match /achievements/{id} {
      allow read: if activeUser();
      allow create, update, delete: if manager();
    }

    match /userAchievements/{id} {
      allow read: if activeOwner(resource.data.userId);
      allow create: if manager();
      allow update, delete: if manager();
    }

    // Written only by Cloud Functions (admin SDK). Super admins can review events.
    match /securityEvents/{id} {
      allow read: if admin();
      allow write: if false;
    }

    // One active device per student. Written only by the claimDeviceSession function.
    match /userSessions/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    match /lessonAccessCounters/{id} {
      allow read, write: if false;
    }

    match /systemSettings/maintenance {
      allow read: if true;
      allow create, update: if manager();
      allow delete: if manager();
    }

    // Legacy exam collections are intentionally not exposed by the application.
    // They remain closed unless an administrator explicitly needs them later.
    match /exams/{id} {
      allow read, write: if false;
    }

    match /examAttempts/{id} {
      allow read, write: if false;
    }

    match /quizzes/{id} {
      allow read: if resource.data.status == 'published' || manager();
      allow create, update: if manager();
      allow delete: if manager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}